{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "left",
  "spacing": 0,
  "width": 24,
  "fixed-center": true,
  "modules-center": ["custom/r-side-2", "group/all", "custom/l-side-2"],

  "group/all": {
    "orientation": "vertical",
    "modules": [
      "custom/omarchy",
      "custom/r-side-4",
      "group/middle",
      "custom/l-side-4",
      "custom/power",
    ],
  },
  "group/middle": {
    "orientation": "vertical",
    "modules": [
      "hyprland/workspaces",
      "custom/r-side-3",
      "group/center",
      "custom/l-side-3",
      "group/expand-task",
    ],
  },
  "group/center": {
    "orientation": "vertical",
    "modules": [
      "group/active",
      "custom/r-side",
      "clock",
      "custom/l-side",
      "custom/weather",
      "group/tray-expander",
    ],
  },

  "group/expand-task": {
    "orientation": "vertical",
    "modules": ["group/task", "group/hardware"],
  },

  "group/active": {
    "orientation": "vertical",
    "modules": [
      "custom/update",
      "custom/screenrecording-indicator",
      "custom/idle-indicator",
      "custom/notification-silencing-indicator",
      "custom/voxtype",
      "custom/reminder",
      "mpris",
    ],
  },

  "group/hardware": {
    "orientation": "vertical",
    "modules": [
      "bluetooth",
      "custom/network",
      "group/volume-drawer",
      "battery",
    ],
  },
  "group/task": {
    "orientation": "vertical",
    "modules": ["memory", "custom/cpu", "custom/gpu"],
  },
  "group/volume-drawer": {
    "orientation": "vertical",
    "drawer": {
      "transition-duration": 500,
      "children-class": "volume-slider",
      "transition-left-to-right": false,
    },
    "modules": ["pulseaudio", "pulseaudio/slider"],
  },
  "hyprland/workspaces": {
    "on-click": "activate",
    "justify": "center",
    "align": 0.5,
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "empty": "",
      "active": "󰫢",
    },
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "6": [],
      "7": [],
      "8": [],
    },
  },
  "custom/omarchy": {
    "format": "<span font_family='omavy'>D</span>",
    "on-click": "omarchy-menu",
    "on-click-right": "xdg-terminal-exec",
    "tooltip-format": "Omarchy Menu\n\nSuper + Alt + Space",
    "justify": "center",
    "align": 0.5,
  },
  "clock": {
    "format": "{:%H\n%M}",
    "tooltip": true,
    "tooltip-format": "{:%A, %d %B %Y}",
    "on-click": "notify-send -u low \"$(date)\"",
    "on-click-right": "omarchy-launch-floating-terminal-with-presentation omarchy-tz-select",
  },
  "custom/update": {
    "format": "",
    "exec": "omarchy-update-available",
    "on-click": "omarchy-launch-floating-terminal-with-presentation omarchy-update",
    "tooltip-format": "Omarchy update available",
    "signal": 7,
    "interval": 21600,
  },
  "custom/network": {
    "exec": "~/.config/waybar/scripts/network-speed.sh",
    "interval": 2,
    "return-type": "json",
    "format": "{}",
    "on-click": "hyprctl dispatch exec '[float; size 800 500; center] xdg-terminal-exec ethtui'",
    "on-click-right": "omarchy-launch-wifi",
  },
  "battery": {
    "format": "{icon}",
    "format-discharging": "{icon}",
    "format-charging": "{icon}",
    "format-plugged": "",
    "format-icons": {
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    },
    "format-full": "󰂅",
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
    "interval": 5,
    "on-click": "omarchy-menu power",
    "states": {
      "warning": 20,
      "critical": 10,
    },
  },
  "custom/weather": {
    "exec": "$OMARCHY_PATH/default/waybar/weather.sh",
    "return-type": "json",
    "interval": 60,
    "tooltip": false,
    "on-click": "notify-send -u low \"$(omarchy-weather-status)\"",
  },
  "bluetooth": {
    "format": "",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "",
    "format-no-controller": "",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "omarchy-launch-bluetooth",
  },
  "pulseaudio": {
    "format": "{icon}",
    "on-click": "omarchy-launch-audio",
    "on-click-right": "pamixer -t",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-muted": "󰓄",
    "format-icons": {
      "headphone": "󰋋",
      "headset": "󰋎",
      "default": "󰓃",
    },
  },
  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "vertical",
    "on-click": "true",
    "tooltip": true,
    "tooltip-format": "Volume: {volume}%",
  },
  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item",
    },
    "modules": ["custom/expand-icon", "tray"],
  },
  "custom/expand-icon": {
    "format": "",
    "tooltip": false,
    "rotate": 0,
  },
  "custom/screenrecording-indicator": {
    "on-click": "omarchy-capture-screenrecording",
    "exec": "$OMARCHY_PATH/default/waybar/indicators/screen-recording.sh",
    "signal": 8,
    "return-type": "json",
  },
  "custom/idle-indicator": {
    "on-click": "omarchy-toggle-idle",
    "exec": "$OMARCHY_PATH/default/waybar/indicators/idle.sh",
    "signal": 9,
    "return-type": "json",
  },
  "custom/notification-silencing-indicator": {
    "on-click": "omarchy-toggle-notification-silencing",
    "exec": "$OMARCHY_PATH/default/waybar/indicators/notification-silencing.sh",
    "signal": 10,
    "return-type": "json",
  },
  "custom/voxtype": {
    "exec": "omarchy-voxtype-status",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "idle": "",
      "recording": "󰍬",
      "transcribing": "󰔟",
    },
    "tooltip": true,
    "on-click-right": "omarchy-voxtype-config",
    "on-click": "omarchy-voxtype-model",
  },
  "tray": {
    "icon-size": 10,
    "spacing": 10,
  },
  "custom/cpu": {
    "exec": "~/.config/waybar/scripts/cpu.sh",
    "interval": 2,
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "on-click": "bash -c 'if [ -f /tmp/waybar_cpu_state ]; then if [ \"$(cat /tmp/waybar_cpu_state)\" = \"usage\" ]; then echo \"temp\" > /tmp/waybar_cpu_state; else echo \"usage\" > /tmp/waybar_cpu_state; fi; else echo \"temp\" > /tmp/waybar_cpu_state; fi; pkill -SIGRTMIN+1 waybar'",
    "on-click-right": "omarchy-launch-or-focus-tui btop",
    "signal": 1,
  },
  "custom/gpu": {
    "exec": "~/.config/waybar/scripts/gpu.sh",
    "interval": 2,
    "format": "{}",
    "return-type": "json",
    "tooltip": true,
    "on-click": "bash -c 'if [ -f /tmp/waybar_gpu_state ]; then if [ \"$(cat /tmp/waybar_gpu_state)\" = \"usage\" ]; then echo \"temp\" > /tmp/waybar_gpu_state; else echo \"usage\" > /tmp/waybar_gpu_state; fi; else echo \"temp\" > /tmp/waybar_gpu_state; fi; pkill -SIGRTMIN+2 waybar'",
    "on-click-right": "hyprctl dispatch exec \"[float] $TERMINAL -e nvtop\"",
    "signal": 2,
  },
  "memory": {
    "interval": 2,
    "format": "{icon}",
    "format-icons": ["󰝦", "󰪞", "󰪟", "󰪣", "󰪤", "󰪥", "󰪢"],
    "on-click": "omarchy-launch-or-focus-tui btop",
  },
  "mpris": {
    "format": "{status}",
    "format-paused": "",
    "format-playing": "",
    "format-stopped": "",
    "players": ["playerctl"],
    "tooltip-format": "{player}: {title} - {artist}",
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl stop",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "justify": "center",
    "align": 0.5,
  },
  "custom/power": {
    "format": "⏼",
    "tooltip": false,
    "on-click": "omarchy menu system",
    "on-click-right": "hyprlock",
  },
  "custom/reminder": {
    "exec": "if systemctl --user list-timers 'omarchy-reminder-*.timer' --no-legend | grep -q 'reminder'; then echo '{\"text\": \"󱅫\", \"class\": \"active\"}'; else echo '{\"text\": \"󰂝\", \"class\": \"none\"}'; fi",
    "return-type": "json",
    "interval": 10,
    "format": "{}",
    "on-click": "omarchy-menu reminder-set",
    "on-click-middle": "omarchy-reminder show",
    "on-click-right": "omarchy-reminder clear && pkill -RTMIN+9 waybar",
    "signal": 9,
  },
  "custom/r-side": {
    "format": "<span font_family='omavy'>B</span>",
    "tooltip": false,
  },
  "custom/l-side": {
    "format": "<span font_family='omavy'>A</span>",
    "tooltip": false,
  },
  "custom/r-side-2": {
    "format": "<span font_family='omavy'>B</span>",
    "tooltip": false,
  },
  "custom/l-side-2": {
    "format": "<span font_family='omavy'>A</span>",
    "tooltip": false,
  },
  "custom/r-side-3": {
    "format": "<span font_family='omavy'>B</span>",
    "tooltip": false,
  },
  "custom/l-side-3": {
    "format": "<span font_family='omavy'>A</span>",
    "tooltip": false,
  },
  "custom/r-side-4": {
    "format": "<span font_family='omavy'>B</span>",
    "tooltip": false,
  },
  "custom/l-side-4": {
    "format": "<span font_family='omavy'>A</span>",
    "tooltip": false,
  },
}
