{
  "__comment": "Built-in Waybar modules only. Custom modules are in custom-modules.jsonc",

  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "format-window-separator": "",
    "format-icons": {
      "default": "",
      "empty": "",
      "active": "<span size='3pt'> </span>󰫢",
    },
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": [],
    },
  },

  "clock": {
    "format": "{:%H\n%M}",
    "format-alt": "\r{0:%d}\r--\r{0:%m}\r--\r{0:%y}",
    "justify": "center",
    "align": 0.5,
    "tooltip-format": "<span>{calendar}</span>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "format": {
        "month": "<span color='#ffead3'><b>{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>",
      },
    },
  },

  "battery": {
    "format": "{capacity}% {icon}",
    "format-discharging": "{icon}",
    "format-charging": "{icon}",
    "format-plugged": "",
    "format-icons": {
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    },
    "format-full": "󰂅",
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
    "interval": 5,
    "on-click": "omarchy-menu power",
    "states": {
      "warning": 20,
      "critical": 10,
    },
  },

  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": "",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "hyprctl dispatch exec \"[float] $TERMINAL -e bluetui\"",
  },

  "network": {
    "format-wifi": "",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "{essid} ({signal}%)",
    "tooltip-format-ethernet": "{ifname}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "hyprctl dispatch exec \"[float] $TERMINAL -e nmtui\"",
  },

  "backlight": {
    "device": "intel_backlight",
    "format": "{icon}",
    "tooltip-format": "brightness control: {percent}%",
    "format-icons": ["🌑", "🌘", "🌗", "🌖", "🌕"],
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-",
    "interval": 2,
  },

  "pulseaudio": {
    "format": "<span font='12'>{icon}</span>",
    "format-bluetooth": "<span font='12'>{icon}</span>",
    "format-bluetooth-muted": "󰝟",
    "format-muted": "󰝟",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋋",
      "headset": "󰋎",
      "phone": "󰟢",
      "portable": "󰐥",
      "car": "󰄋",
      "default": ["󰕿", "󰖀", "󰕾"],
    },
    "on-click": "pavucontrol",
    "tooltip": true,
    "tooltip-format": "{desc} | {volume}%",
    "scroll-step": 5,
    "justify": "center",
    "align": 0.5,
  },

  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item",
    },
    "modules": ["custom/expand-icon", "tray"],
  },

  "group/system-capsule": {
    "orientation": "inherit",
    "justify": "center",
    "align": 0.5,
    "modules": [
      "group/system-info",
      "custom/todo",
      "bluetooth",
      "network",
      "pulseaudio",
      "battery",
    ],
  },

  "group/system-info": {
    "orientation": "inherit",
    "justify": "center",
    "align": 0.5,
    "modules": [
      "custom/update",
      "custom/idle-indicator",
      "memory",
      "custom/cpu",
      "custom/gpu",
    ],
  },

  "tray": {
    "icon-size": 12,
    "spacing": 12,
  },

  "memory": {
    "interval": 2,
    "format": "{icon}",
    "format-icons": ["󰪞", "󰪟", "󰪠", "󰪡", "󰪢", "󰪣", "󰪤", "󰪥"],
    "on-click": "omarchy-launch-or-focus-tui btop",
  },

  "custom/cpu": {
    "exec": "~/.config/waybar/scripts/cpu.sh",
    "interval": 2,
    "return-type": "json",
    "format": "{}",
    "format-alt": "{alt}",
    "tooltip": true,
    "on-click-right": "omarchy-launch-or-focus-tui btop",
  },

  "custom/gpu": {
    "exec": "~/.config/waybar/scripts/gpu.sh",
    "interval": 2,
    "format": "{}",
    "format-alt": "{alt}",
    "return-type": "json",
    "tooltip": true,
    "on-click-right": "hyprctl dispatch exec \"[float] $TERMINAL -e nvtop",
  },

  "mpris": {
    "format": "{player_icon} {artist} - {title}",
    "format-paused": "{status_icon} <i>{artist} - {title}</i>",
    "player-icons": {
      "default": "🎵",
      "mpv": "🎵",
    },
    "status-icons": {
      "paused": "⏸",
    },
    "max-length": 50,
  },

  "hyprland/window": {
    "format": "{}",
  },
}
