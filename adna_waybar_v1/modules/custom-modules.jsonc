{
  "custom/todo": {
    "exec": "/home/fross/go/bin/todo",
    "format": "",
    "tooltip": true,
    "tooltip-format": "Todo list",
    /* Updated: size width to 800 | move X to 100%-815 (800 width + 15 margin) */
    "on-click": "hyprctl dispatch exec \"[float; size 800 600; move 100%-815 55] xdg-terminal-exec /home/fross/go/bin/todo\"",
  },

  "custom/power": {
    "format": "⏻",
    "tooltip": true,
    "tooltip-format": "Power Menu",
    "on-click": "omarchy-menu system",
  },

  "custom/omarchy": {
    "format": "<span font='omarchy'>\ue900</span>",
    "on-click": "~/.local/share/omarchy/bin/omarchy-menu",
    "tooltip-format": "SUPER + ALT + SPACE",
  },

  "custom/update": {
    "format": "",
    "exec": "omarchy-update-available",
    "on-click": "omarchy-launch-floating-terminal-with-presentation omarchy-update",
    "tooltip-format": "Omarchy update available",
    "interval": 3600,
  },

  "custom/expand-icon": {
    "format": " ",
    "tooltip": false,
    "justify": "center",
    "align": 0.5,
  },

  "custom/screenrecording-indicator": {
    "on-click": "omarchy-cmd-screenrecord",
    "exec": "$OMARCHY_PATH/default/waybar/indicators/screen-recording.sh",
    "signal": 8,
    "return-type": "json",
  },

  "custom/idle-indicator": {
    "exec": "$OMARCHY_PATH/default/waybar/indicators/idle.sh",
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "on-click": "omarchy-toggle-idle",
    "signal": 9,
  },

  "custom/privacydots": {
    "exec": "~/.config/waybar/scripts/privacydots.sh",
    "return-type": "json",
    "interval": 2,
    "format": "{}",
    "tooltip": true,
    "escape": false,
    "markup": "pango",
    "align": 0.5,
    "rotate": 90,
  },
}
